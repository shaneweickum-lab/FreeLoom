NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Canonical production URL (src/lib/appUrl.ts) -- used for Stripe Checkout/
# Portal redirects and links in outgoing email notifications. Defaults to
# https://www.freeloom.io if unset; only set this to override that (e.g. a
# preview deployment that needs its own domain in redirect URLs).
NEXT_PUBLIC_APP_URL=

# Plan caps shown on /admin's Usage tab (GB, decimals allowed). Defaults
# match Supabase's free tier (0.5GB database, 1GB storage) if unset -- bump
# these after upgrading the project's plan.
SUPABASE_DB_LIMIT_GB=0.5
SUPABASE_STORAGE_LIMIT_GB=1

# Any random string -- Vercel Cron sends it as a bearer token when it hits
# /api/cron/cleanup-threads (see vercel.json), so the route can tell a real
# cron invocation apart from an arbitrary request. Set the same value in
# Vercel's project env vars.
CRON_SECRET=

# Where /api/cron/cleanup-threads emails a best-effort alert if the daily
# cleanup run itself fails -- otherwise a failure is only visible in
# Vercel's own cron logs/dashboard, which nobody is watching day to day.
# A no-op (same as every other Resend call site) if unset.
OPS_ALERT_EMAIL=

# Stage 4 SLM entry-drafting fallback (src/lib/pipeline/slmDraft.ts). Points
# at ml/serve/inference_server.py -- directly at http://localhost:8000 for
# local testing, or at a tunnel's public URL (see ml/serve/README.md) once
# FreeLoom's deployed app needs to reach it. Unset means this feature is
# fully inert (Stage 4 always falls through to Stage 5, same as before it
# existed).
SLM_ENTRY_DRAFTING_URL=

# Benny assistant-mode chat backend (src/lib/benny/chat.ts). Same server as
# SLM_ENTRY_DRAFTING_URL above (one process serves both routes) -- set this
# to the same URL. Unset means Benny always replies with a placeholder.
SLM_CHAT_URL=

# Shared secret both of the above send as `Authorization: Bearer <value>` --
# must match the SLM_SHARED_SECRET the inference server itself was started
# with (see ml/serve/inference_server.py's usage comment), since that
# server is reachable from the public internet and has no other way to
# tell a real FreeLoom request apart from anyone else who finds the URL.
SLM_SHARED_SECRET=

# Stripe billing (src/lib/stripe.ts, src/app/api/billing/*, src/app/api/
# webhooks/stripe). STRIPE_SECRET_KEY is the account's secret API key.
# STRIPE_WEBHOOK_SECRET is the signing secret for the webhook endpoint
# configured in the Stripe Dashboard pointing at /api/webhooks/stripe.
# The six Price ID vars are the Price objects for each (tier, billing
# interval) pair under the "FreeLoom Pro"/"FreeLoom Premium" Products --
# there's no Free-tier Price since Free never creates a Stripe subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_QUARTERLY=
STRIPE_PRICE_PREMIUM_YEARLY=
