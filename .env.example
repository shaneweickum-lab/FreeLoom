NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Canonical production URL (src/lib/appUrl.ts) -- used for Stripe Checkout/
# Portal redirects and links in outgoing email notifications. Defaults to
# https://www.freeloom.io if unset; only set this to override that (e.g. a
# preview deployment that needs its own domain in redirect URLs).
NEXT_PUBLIC_APP_URL=

# Plan caps shown on /admin's Usage tab (GB, decimals allowed). Defaults
# match Supabase's free tier (0.5GB database, 1GB storage) if unset -- bump
# these after upgrading the project's plan.
SUPABASE_DB_LIMIT_GB=0.5
SUPABASE_STORAGE_LIMIT_GB=1

# Any random string -- Vercel Cron sends it as a bearer token when it hits
# /api/cron/cleanup-threads (see vercel.json), so the route can tell a real
# cron invocation apart from an arbitrary request. Set the same value in
# Vercel's project env vars.
CRON_SECRET=

# Stage 4 SLM entry-drafting fallback (src/lib/pipeline/slmDraft.ts). Unset
# in every environment today -- no such endpoint exists yet.
SLM_ENTRY_DRAFTING_URL=

# Benny assistant-mode chat backend (src/lib/benny/chat.ts). Unset in every
# environment today -- Benny replies with a placeholder until this points at
# a real endpoint.
SLM_CHAT_URL=

# Stripe billing (src/lib/stripe.ts, src/app/api/billing/*, src/app/api/
# webhooks/stripe). STRIPE_SECRET_KEY is the account's secret API key.
# STRIPE_WEBHOOK_SECRET is the signing secret for the webhook endpoint
# configured in the Stripe Dashboard pointing at /api/webhooks/stripe.
# The six Price ID vars are the Price objects for each (tier, billing
# interval) pair under the "FreeLoom Pro"/"FreeLoom Premium" Products --
# there's no Free-tier Price since Free never creates a Stripe subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_QUARTERLY=
STRIPE_PRICE_PREMIUM_YEARLY=
